# Copier ce fichier en .env (jamais commité) puis le remplir.
TZ=Europe/Paris

# Contact transmis aux services push (obligatoire par la norme Web Push)
VAPID_SUBJECT=mailto:change-moi@exemple.fr

# Home Assistant : URL interne + jeton d'accès longue durée (Profil > Sécurité)
HA_URL=http://ip-de-home-assistant:8123
HA_TOKEN=

# Adresse publique utilisée dans le lien Google Agenda (voir README)
FEED_BASE_URL=

# Photo de référence automatique (iNaturalist) pour les plantes sans photo : 1 ou 0
PHOTO_LOOKUP=1

# Optionnel : authentification HTTP basique
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
